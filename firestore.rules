rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // Users
    match /users/{uid} {
      allow read: if isAuthed();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);

      match /following/{targetUid} {
        allow read, write: if isOwner(uid);
      }
      match /followers/{followerUid} {
        allow read: if isAuthed();
        allow write: if isAuthed();
      }

      // Wallet (viewer-side coin balance).
      // Owner can read. Owner can decrement coins (e.g. when sending a gift).
      // Increments come from the Stripe webhook (server-side, bypasses rules).
      // TODO production: route all gift-related decrements through a Cloud Function
      // to remove any client-side write capability on wallet.
      match /wallet/{doc} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) &&
          request.resource.data.coins <= resource.data.coins;
      }

      // Creator-side diamond balance.
      // Owner can read. Diamonds can only ever increase, and may be incremented
      // by any authed user (gift senders). Cash-out is handled server-side.
      // TODO production: migrate to Cloud Function for self-gift prevention.
      match /creatorBalance/{doc} {
        allow read: if isOwner(uid);
        allow create: if isAuthed() &&
          request.resource.data.keys().hasOnly(['diamonds', 'lifetimeDiamonds', 'updatedAt']) &&
          request.resource.data.diamonds >= 0 &&
          request.resource.data.lifetimeDiamonds >= 0;
        allow update: if isAuthed() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['diamonds', 'lifetimeDiamonds', 'updatedAt']) &&
          request.resource.data.diamonds >= resource.data.diamonds &&
          request.resource.data.lifetimeDiamonds >= resource.data.lifetimeDiamonds;
      }

      // IAP transaction ledger — server-side only (Cloud Functions credit via
      // Admin SDK which bypasses these rules). Owner can read their own
      // purchase history; no client writes allowed.
      match /iapTransactions/{txId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Diamond → USD payout ledger — written only by the requestDiamondPayout
      // Cloud Function (Admin SDK bypasses rules). Owner reads their history;
      // no client writes (the diamond debit must go through the function).
      match /payouts/{payoutId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Videos — public read so the feed loads without signing in
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthed() &&
        // allow only specific counter fields to be incremented by any user
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount', 'commentCount', 'shareCount', 'viewCount'])
        || isOwner(resource.data.authorUid));
      allow delete: if isOwner(resource.data.authorUid);

      match /likes/{uid} {
        allow read: if true;
        allow write: if isOwner(uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthed();
        allow delete: if isOwner(resource.data.authorUid);
      }
    }

    // Gift catalog — public read so any signed-in (or signed-out) client can
    // render gift panels. No client-side writes; catalog edits go through an
    // admin tool (currently: edit docs directly in the Firebase Console;
    // future: a proper admin UI that uses an admin-claim-gated Cloud
    // Function).
    match /giftCatalog/{giftId} {
      allow read: if true;
      allow write: if false;
    }

    // Game catalog (Game Zone 3d) — public read; only admins may author. Games
    // layer over / replace the in-app static catalog, so entries can be
    // added/tuned without an app release. Admin = an admins/{uid} doc.
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAuthed()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist — bootstrapped by hand in the Firebase Console. A user
    // may read their own row (to reveal the authoring UI); no client writes.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Live streams — public read so discovery page works without signing in
    match /streams/{streamId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAuthed() &&
        (isOwner(resource.data.hostUid) ||
          // Any authenticated user can update viewerCount and totalGifts
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['viewerCount', 'totalGifts', 'peakViewerCount']));
      allow delete: if isOwner(resource.data.hostUid);

      match /gifts/{giftId} {
        allow read: if true;
        allow create: if isAuthed() && request.resource.data.senderUid == request.auth.uid;
      }

      // Per-stream gifter leaderboard aggregate. Each sender maintains their
      // own row (doc id == their uid), incremented inside the sendGift
      // transaction. Anyone may read to render the board.
      match /gifters/{gifterUid} {
        allow read: if true;
        allow write: if isAuthed() && gifterUid == request.auth.uid;
      }

      match /cohosts/{cohostUid} {
        allow read: if true;
        allow write: if isAuthed();
      }

      // Viewer game challenges (Game Zone 3c). A viewer creates a 'pending'
      // dare; the host accepts/declines; the challenger settles it (paid/failed)
      // on their own client (only the wallet owner may spend their coins). The
      // coin debit + diamond credit ride the existing wallet/creatorBalance
      // rules, which already gate those writes.
      match /gameChallenges/{challengeId} {
        allow read: if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isAuthed() && (
          request.auth.uid == resource.data.fromUid ||
          request.auth.uid == get(/databases/$(database)/documents/streams/$(streamId)).data.hostUid
        );
      }
    }

    // Co-host invites — written by hosts to other users' documents
    match /users/{uid}/cohost_invites/{inviteId} {
      allow read: if isOwner(uid);
      allow write: if isAuthed();
    }

    // Sponsorships (sponsored gifts) — any authenticated user can read to render
    // brand-styled gifts in the picker; only the owning brand may create/update;
    // any authed user may increment totalSendCount / totalBrandSpendUsd via the
    // recordSend code path (those increments are bounded to specific fields).
    match /sponsorships/{sponsorshipId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.brandId == request.auth.uid;
      allow update: if isAuthed() && (
        isOwner(resource.data.brandId) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalSendCount', 'totalBrandSpendUsd'])
      );
      allow delete: if isOwner(resource.data.brandId);

      match /sends/{sendId} {
        allow read: if isOwner(get(/databases/$(database)/documents/sponsorships/$(sponsorshipId)).data.brandId);
        allow create: if isAuthed() && request.resource.data.senderUid == request.auth.uid;
      }
    }

    // Ads — any authenticated user can read; only owner manages; any authed user can increment counters
    match /ads/{adId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.advertiserId == request.auth.uid;
      allow update: if isAuthed() && (
        isOwner(resource.data.advertiserId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks'])
      );
      allow delete: if isOwner(resource.data.advertiserId);
    }
  }
}
