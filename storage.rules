rules_version = '2';

// Cloud Storage rules for Qaramia. Mirrors the Firestore model:
// `videos/{id}` is publicly readable so the feed and player can stream them,
// and only authenticated users can write — the path itself is a uuid, so
// users can only write to a path nobody else can guess.
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{videoFile} {
      allow read: if true;
      // Videos up to 200 MB, thumbnails up to 5 MB. Both live under the same
      // prefix so the upload pipeline doesn't need a second rule branch.
      allow write: if request.auth != null
                   && (
                        (request.resource.contentType.matches('video/.*')
                         && request.resource.size < 200 * 1024 * 1024)
                        ||
                        (request.resource.contentType.matches('image/.*')
                         && request.resource.size < 5 * 1024 * 1024)
                      );
    }

    // User-uploaded avatars, profile media, etc. Open it later when needed;
    // unmatched paths fall through to the default-deny rule below.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
